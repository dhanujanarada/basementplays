# Copy this file to ticketing/.env for local development.
# `make dev` and `make migrate` load it automatically.
# Never commit a real .env.

# Local socket connection. Use the TCP form for remote hosts, e.g.
# postgres://user:pass@db.example.com:5432/ticketing?sslmode=verify-full
DATABASE_URL=postgres:///ticketing_dev?host=/var/run/postgresql

PORT=8080
LOG_LEVEL=info

# Server-to-server bearer token for /v1/internal/* (Next.js only).
INTERNAL_TOKEN=dev-internal-token-change-me
# HMAC key for signed QR ticket tokens.
QR_SECRET=dev-qr-secret-change-me
# Public site origin, used in QR links.
PUBLIC_BASE_URL=http://localhost:3000

HOLD_MINUTES=10
CHECKOUT_HOLD_MINUTES=15
MANUAL_HOLD_HOURS=24
MAX_SEATS_PER_ORDER=6
MAX_PLAN_SEATS=500

# Comma-separated exact origins, only used for /v1/public/*. Empty = no CORS.
CORS_ALLOWED_ORIGINS=

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_ALLOW_LIVE=false

# Run pending migrations on `serve` (in addition to `ticketing migrate`).
RUN_MIGRATIONS_ON_START=true
SHUTDOWN_TIMEOUT=10s
