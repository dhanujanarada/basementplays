DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional member account for verifying restricted Backstage access.
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=change-me-too

# Frontend ticketing. "mock" (the default) keeps demo data in sessionStorage.
# "http" is not wired yet and fails fast until the API client and proxy land.
NEXT_PUBLIC_TICKET_API_MODE=mock

# Optional. Absolute site URL used to build ticket QR links when the request
# headers do not carry the public host (for example behind a proxy).
# NEXT_PUBLIC_SITE_URL=https://basementplays.example

